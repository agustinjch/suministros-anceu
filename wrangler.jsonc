{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "suministros-anceu",
  "compatibility_date": "2026-07-31",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Dominio propio: wrangler crea el registro DNS en la zona anceu.com y
  // gestiona el certificado. La zona ya existe en esta misma cuenta.
  "routes": [
    {
      "pattern": "suministros.anceu.com",
      "custom_domain": true
    }
  ],
  // Necesario para ver en el panel los logs del Worker, donde queda el id de
  // Resend de cada envio.
  "observability": {
    "enabled": true
  }
}
